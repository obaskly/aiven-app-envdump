#!/bin/sh
echo "Content-type: text/plain"
echo ""
h=$(echo "$QUERY_STRING" | sed -n 's/.*h=\([^&]*\).*/\1/p')
p=$(echo "$QUERY_STRING" | sed -n 's/.*p=\([^&]*\).*/\1/p')
q=$(echo "$QUERY_STRING" | sed -n 's/.*q=\([^&]*\).*/\1/p')
[ -z "$p" ] && p=8080
[ -z "$q" ] && q=/cgi-bin/i
case "$h" in *:*) H="[$h]";; *) H="$h";; esac
echo "FROM=$(hostname)"
echo "TARGET=http://$H:$p$q"
curl -sS -m 8 -i "http://$H:$p$q" 2>&1 | head -c 1500
echo ""
echo "DONE"
